# Jotform API Configuration
# Copy this file to .env and fill in your actual API keys

# Your Jotform API Keys
# Get these from your Jotform account settings
VITE_API_KEY1=your_api_key_here
VITE_API_KEY2=your_second_api_key_here
VITE_API_KEY3=your_third_api_key_here

# Form IDs for your investigation forms
# Update these in src/config/forms.js with your actual form IDs
VITE_FORM_ID_CHECKINS=your_checkins_form_id
VITE_FORM_ID_SIGHTINGS=your_sightings_form_id
VITE_FORM_ID_MESSAGES=your_messages_form_id
VITE_FORM_ID_PERSONAL_NOTES=your_personal_notes_form_id
VITE_FORM_ID_ANONYMOUS_TIPS=your_anonymous_tips_form_id
